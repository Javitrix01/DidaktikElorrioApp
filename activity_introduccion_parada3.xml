<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".IntroduccionParada3">

    <ScrollView
        android:id="@+id/SVUdaletxe"
        android:layout_width="413dp"
        android:layout_height="216dp"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <TextView
            android:id="@+id/textViewIntroUdaletxe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/elorrioko_udaletxea_elorrioko_udaletxea_gernikako_arbola_plazan_kokatuta_dago_eta_xviii_mendean_eraiki_zuten_estilo_euskal_barrokoa_da_eta_asmo_urbanoa_eta_monumentala_du" />
    </ScrollView>

    <ImageView
        android:id="@+id/imageView14"
        android:layout_width="220dp"
        android:layout_height="208dp"
        android:contentDescription="@string/alcalde"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.413"
        tools:srcCompat="@drawable/alcalde1" />

    <LinearLayout
        android:id="@+id/linearLayout9"
        android:layout_width="409dp"
        android:layout_height="147dp"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.797">

        <Button
            android:id="@+id/btn_inicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Hasi" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="57dp" />

        <Button
            android:id="@+id/btnJarraituP3"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:text="@string/jarraitu" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>