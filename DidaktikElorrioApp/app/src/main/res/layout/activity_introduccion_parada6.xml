<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background7"
    tools:context=".IntroduccionParada6">

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="240dp"
        android:layout_height="315dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="1dp"
        android:background="@drawable/rounded_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textViewIntroErrenbonbiloa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/errebonbilloaren"
            android:textColor="@color/black" />
    </ScrollView>

    <LinearLayout
        android:layout_width="409dp"
        android:layout_height="147dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="68dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scrollView2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSonidoP1"
                android:layout_width="51dp"
                android:layout_height="67dp"
                android:background="@android:drawable/ic_media_play"
                app:iconTint="@color/places_autocomplete_separator"
                tools:ignore="SpeakableTextPresentCheck" />

            <SeekBar
                android:id="@+id/seekBar4"
                android:layout_width="wrap_content"
                android:layout_height="68dp"
                android:layout_weight="1" />

        </LinearLayout>

        <Button
            android:id="@+id/btnJarraituP6"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:text="@string/jarraitu" />

    </LinearLayout>

    <ImageView
        android:id="@+id/imageView15"
        android:layout_width="211dp"
        android:layout_height="258dp"
        android:layout_marginEnd="23dp"
        android:src="@drawable/sombrero1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/scrollView2"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.458" />

</androidx.constraintlayout.widget.ConstraintLayout>