        android:layout_height="229dp"
        android:src="@drawable/mapacrucessinnombre"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.25"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/et_SanJuan"
        android:layout_width="73dp"
        android:layout_height="49dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:autofillHints=""
        android:ems="10"
        android:inputType="textPersonName"
        android:textColor="@color/secondWood"
        app:layout_constraintEnd_toStartOf="@+id/et_Txanberi"
        app:layout_constraintTop_toBottomOf="@+id/et_Ganondo"
        tools:ignore="SpeakableTextPresentCheck" />

    <EditText
        android:id="@+id/et_kurutziaga"
        android:layout_width="91dp"
        android:layout_height="48dp"
        android:layout_marginBottom="100dp"
        android:autofillHints=""
        android:ems="10"
        android:inputType="textPersonName"
        android:textColor="@color/secondWood"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout2"
        app:layout_constraintEnd_toEndOf="@+id/imageView7"
        app:layout_constraintHorizontal_bias="0.019"
        app:layout_constraintStart_toEndOf="@+id/et_SantaElena"
