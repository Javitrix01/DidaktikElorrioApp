        app:layout_constraintTop_toBottomOf="@+id/et_Kurutzondo"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="SpeakableTextPresentCheck" />

    <EditText
        android:id="@+id/et_Kurutzondo"
