<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backgroundblue"
    tools:ignore="RtlHardcoded">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:layout_margin="7dp"
        android:layout_marginBottom="10dp"
        android:layout_alignParentEnd="true">

        <ImageButton
            android:id="@+id/bBackMenu9"
            android:background="@drawable/back"
            style="@style/bNavigationStyle"
            android:layout_alignParentLeft="true"
            android:contentDescription="@string/button"
            />

        <ImageButton
            android:id="@+id/bSoundOffOn9"
            style="@style/bNavigationStyle"
            android:layout_alignParentRight="true"
            android:background="@android:color/transparent"
            android:contentDescription="@string/button"
            android:src="@drawable/soundoff" />
        <ImageButton
            android:id="@+id/bNewGame9"
            android:background="@drawable/restart"
            style="@style/bNavigationStyle"
            android:layout_centerHorizontal="true"
            android:contentDescription="@string/button"/>

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/gameTitle9"
            style="@style/textPuzzleStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fontdiner_swanky"
            android:text="@string/game8"
            android:textColor="#FFFFFF"
            android:textSize="48sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tSScore9"
                style="@style/textGameStyle"
                android:fontFamily="@font/asap"
                android:text="@string/Score"
                android:textSize="@dimen/textScore9" />

            <TextView
                android:id="@+id/tScore9"
                style="@style/textGameStyle"
                android:textSize="@dimen/textScore9" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tBestSScore9"
                style="@style/textGameStyle"
                android:fontFamily="@font/asap"
                android:text="@string/bestScore"
                android:textSize="@dimen/textRecord9" />

            <TextView
                android:id="@+id/tBestScore9"
                style="@style/textGameStyle"
                android:textSize="@dimen/textRecord9" />
        </LinearLayout>

        <GridLayout

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/grid_border"
            android:columnCount="3"
            android:layoutDirection="ltr"
            android:rowCount="3">

            <ImageButton
                android:id="@+id/b900"
                style="@style/gridBGameStyle9"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_marginStart="@dimen/button_margin_border"
                android:layout_marginTop="@dimen/button_margin_border"
                android:layout_marginEnd="@dimen/button_margin"
                android:contentDescription="@string/button" />

            <ImageButton
                android:id="@+id/b901"
                style="@style/gridBGameStyle9"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_marginTop="@dimen/button_margin_border"
                android:layout_marginEnd="@dimen/button_margin"
                android:contentDescription="@string/button" />

            <ImageButton
                android:id="@+id/b902"
                style="@style/gridBGameStyle9"
                android:layout_row="0"
                android:layout_column="2"
                android:layout_marginTop="@dimen/button_margin_border"
                android:layout_marginEnd="@dimen/button_margin_border"
                android:contentDescription="@string/button" />

            <ImageButton
                android:id="@+id/b910"
                style="@style/gridBGameStyle9"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_marginStart="@dimen/button_margin_border"
                android:layout_marginTop="@dimen/button_margin"
                android:layout_marginEnd="@dimen/button_margin"
                android:contentDescription="@string/button" />

            <ImageButton
                android:id="@+id/b911"
                style="@style/gridBGameStyle9"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_marginTop="@dimen/button_margin"
                android:layout_marginEnd="@dimen/button_margin"
                android:contentDescription="@string/button" />

            <ImageButton
                android:id="@+id/b912"
                style="@style/gridBGameStyle9"
                android:layout_row="1"
                android:layout_column="2"
                android:layout_marginTop="@dimen/button_margin"
                android:layout_marginEnd="@dimen/button_margin_border"
                android:contentDescription="@string/button" />

            <ImageButton
                android:id="@+id/b920"
                style="@style/gridBGameStyle9"
                android:layout_row="2"
                android:layout_column="0"
                android:layout_marginStart="@dimen/button_margin_border"
                android:layout_marginTop="@dimen/button_margin"
                android:layout_marginEnd="@dimen/button_margin"
                android:layout_marginBottom="@dimen/button_margin_border"
                android:contentDescription="@string/button" />

            <ImageButton
                android:id="@+id/b921"
                style="@style/gridBGameStyle9"
                android:layout_row="2"
                android:layout_column="1"
                android:layout_marginTop="@dimen/button_margin"
                android:layout_marginEnd="@dimen/button_margin"
                android:layout_marginBottom="@dimen/button_margin_border"
                android:contentDescription="@string/button" />

            <ImageButton
                android:id="@+id/b922"
                style="@style/gridBGameStyle9"
                android:layout_row="2"
                android:layout_column="2"
                android:layout_marginTop="@dimen/button_margin"
                android:layout_marginEnd="@dimen/button_margin_border"
                android:layout_marginBottom="@dimen/button_margin_border"
                android:contentDescription="@string/button" />

        </GridLayout>

        <Button
            android:id="@+id/button3"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/rounded_button"
            android:backgroundTint="#CBFFFFFF"
            android:fontFamily="@font/asap"
            android:text="Trampa Egin!!" />

    </LinearLayout>

</RelativeLayout>
