<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background6"
    tools:context=".IntroduccionParada5">

    <ScrollView
        android:id="@+id/SVJauregia"
        android:layout_width="224dp"
        android:layout_height="351dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/rounded_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textViewIntroJauregia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/arespakotxaga_jauregia"
            android:textAlignment="center"
            android:textColor="@color/black" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/linearLayout10"
        android:layout_width="409dp"
        android:layout_height="147dp"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="88dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSonidoP1"
                android:layout_width="51dp"
                android:layout_height="67dp"
                android:background="@android:drawable/ic_media_play"
                app:iconTint="@color/places_autocomplete_separator"
                tools:ignore="SpeakableTextPresentCheck" />

            <SeekBar
                android:id="@+id/seekBar4"
                android:layout_width="wrap_content"
                android:layout_height="68dp"
                android:layout_weight="1" />

        </LinearLayout>

        <Button
            android:id="@+id/btnJarraituP5"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:text="@string/jarraitu" />

    </LinearLayout>

    <ImageView
        android:id="@+id/imageView16"
        android:layout_width="176dp"
        android:layout_height="245dp"
        android:src="@drawable/reina1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.467" />

</androidx.constraintlayout.widget.ConstraintLayout>