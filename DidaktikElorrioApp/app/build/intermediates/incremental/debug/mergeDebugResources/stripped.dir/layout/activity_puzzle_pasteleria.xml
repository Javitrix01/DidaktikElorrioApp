<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background5"
    tools:context=".Puzzle_Pasteleria">


    <ImageButton
        android:id="@+id/imageHarina"
        android:layout_width="113dp"
        android:layout_height="113dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="23dp"
        android:background="@drawable/harina"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/imagePera"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageQueso"
        app:layout_constraintVertical_bias="0.116"
        tools:ignore="SpeakableTextPresentCheck" />

    <ImageButton
        android:id="@+id/imageChocolateNegro"
        android:layout_width="113dp"
        android:layout_height="113dp"
        android:layout_marginBottom="84dp"
        android:background="@drawable/chocolatenegro"
        app:layout_constraintBottom_toTopOf="@+id/btnPasteleriaBaieztatu"
        tools:ignore="SpeakableTextPresentCheck"
        tools:layout_editor_absoluteX="160dp" />

    <ImageButton
        android:id="@+id/imageChocolateBlanco"
        android:layout_width="113dp"
        android:layout_height="113dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/chocolateblanco"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/imageHuevo"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="SpeakableTextPresentCheck" />

    <ImageButton
        android:id="@+id/imageHuevo"
        android:layout_width="113dp"
        android:layout_height="113dp"
        android:layout_marginTop="100dp"
        android:background="@drawable/huevos"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="SpeakableTextPresentCheck"
        tools:layout_editor_absoluteX="161dp" />

    <ImageButton
        android:id="@+id/imageAzucar"
        android:layout_width="113dp"
        android:layout_height="113dp"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="192dp"
        android:background="@drawable/azucar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/imageChocolateNegro"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageHarina"
        app:layout_constraintVertical_bias="1.0"
        tools:ignore="SpeakableTextPresentCheck" />

    <ImageButton
        android:id="@+id/imageManzana"
        android:layout_width="113dp"
        android:layout_height="113dp"
        android:background="@drawable/manzana"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.555"
        app:layout_constraintStart_toEndOf="@+id/imagePera"
        app:layout_constraintTop_toBottomOf="@+id/imageChocolateBlanco"
        app:layout_constraintVertical_bias="0.116"
        tools:ignore="SpeakableTextPresentCheck" />

    <ImageButton
        android:id="@+id/imagePera"
        android:layout_width="113dp"
        android:layout_height="113dp"
        android:background="@drawable/pera"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageHuevo"
        app:layout_constraintVertical_bias="0.114"
        tools:ignore="SpeakableTextPresentCheck"
        tools:layout_editor_absoluteX="160dp" />

    <ImageButton
        android:id="@+id/imageMermelada"
        android:layout_width="113dp"
        android:layout_height="113dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="192dp"
        android:background="@drawable/mermelada"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.823"
        app:layout_constraintStart_toEndOf="@+id/imageChocolateNegro"
        app:layout_constraintTop_toBottomOf="@+id/imageManzana"
        app:layout_constraintVertical_bias="1.0"
        tools:ignore="SpeakableTextPresentCheck" />

    <ImageButton
        android:id="@+id/imageQueso"
        android:layout_width="113dp"
        android:layout_height="113dp"
        android:layout_marginTop="100dp"
        android:background="@drawable/queso"
        app:layout_constraintEnd_toStartOf="@+id/imageHuevo"
        app:layout_constraintHorizontal_bias="0.51"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="SpeakableTextPresentCheck" />

    <Button
        android:id="@+id/btnPasteleriaBaieztatu"
        android:layout_width="199dp"
        android:layout_height="56dp"
        android:layout_marginBottom="52dp"
        android:text="@string/baieztatu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtExplicacionPasteleria"
        android:layout_width="324dp"
        android:layout_height="49dp"
        android:layout_marginBottom="20dp"
        android:text="@string/explicacionPasteleria"
        android:textColor="#000000"
        app:layout_constraintBottom_toTopOf="@+id/imageHuevo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <ImageView
        android:id="@+id/imageView8"
        android:layout_width="379dp"
        android:layout_height="441dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.75"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.393" />

</androidx.constraintlayout.widget.ConstraintLayout>